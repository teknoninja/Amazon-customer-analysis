# Required: Groq API key (free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Kaggle auth (recommended): API token from https://www.kaggle.com/settings/api
# Looks like: KGAT_...
KAGGLE_API_TOKEN=your_kaggle_api_token_here

# Free tier ~30 RPM + ~8K TPM — keep batches small, then wait out the minute
GROQ_RPM=12
GROQ_WINDOW_SECONDS=60
GROQ_INTRA_BATCH_GAP=1.0
GROQ_MIN_429_SLEEP=25
GROQ_MAX_RETRIES=8
EVAL_SAMPLE_SIZE=30
JUDGE_SAMPLE_SIZE=20
GOLDEN_CHECKPOINT_EVERY=10

